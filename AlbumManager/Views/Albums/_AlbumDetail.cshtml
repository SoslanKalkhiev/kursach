@model Album
@{
    var year = Model.ReleaseDate?.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"));
}

<div class="modal-header detail-header">
    <h5 class="modal-title">Альбом</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
</div>

<div class="modal-body">
    <div class="detail">
        <div class="detail-cover">
            <img class="cover @(string.IsNullOrEmpty(Model.CoverUrl) ? "cover-missing" : "")"
                 src="@Model.CoverUrl" alt="@Model.Title"
                 onerror="this.classList.add('cover-missing');this.removeAttribute('src');" />
        </div>
        <div class="detail-info">
            <h3 class="detail-title">@Model.Title</h3>
            <div class="detail-artist">@Model.Artist</div>

            <div class="detail-rating">
                @Html.Raw(StarRenderer.Render(Model.Rating))
            </div>

            <div class="detail-meta">
                <span class="status-badge @(Model.Status == AlbumStatus.Listened ? "listened" : "planned")">
                    @(Model.Status == AlbumStatus.Listened ? "прослушано" : "в планах")
                </span>
                @if (Model.IsFavorite)
                {
                    <span class="fav-chip">♥ в избранном</span>
                }
            </div>

            @if (year is not null)
            {
                <div class="detail-row"><span class="detail-label">Дата выхода:</span> @year</div>
            }

            @if (Model.Genres.Count > 0)
            {
                <div class="detail-row">
                    <span class="detail-label">Жанры:</span>
                    <span class="genre-chips">
                        @foreach (var g in Model.Genres)
                        {
                            <span class="genre-chip">@g</span>
                        }
                    </span>
                </div>
            }

            <div class="detail-row text-secondary small">
                Добавлен: @Model.DateAdded.ToLocalTime().ToString("dd.MM.yyyy")
            </div>
        </div>
    </div>
</div>

<div class="modal-footer justify-content-between">
    <button type="button" class="btn btn-outline-danger" data-action="delete" data-id="@Model.Id">Удалить</button>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-light" data-action="toggle-fav" data-id="@Model.Id">
            @(Model.IsFavorite ? "Убрать из избранного" : "♥ В избранное")
        </button>
        <button type="button" class="btn btn-accent" data-action="edit" data-id="@Model.Id">Редактировать</button>
    </div>
</div>
