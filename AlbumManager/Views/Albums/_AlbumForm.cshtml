@model Album
@{
    var isEdit = !string.IsNullOrEmpty(Model.Id);
    var ratingValue = Model.Rating?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
    var releaseValue = Model.ReleaseDate?.ToString("yyyy-MM-dd") ?? "";
    var genresValue = string.Join(", ", Model.Genres);
}

<div class="modal-header">
    <h5 class="modal-title">@(isEdit ? "Редактирование альбома" : "Новый альбом")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
</div>

<form id="albumForm" data-edit="@isEdit.ToString().ToLower()">
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="modal-body">
        <div class="itunes-search">
            <label class="form-label">Найти в каталоге iTunes <span class="text-secondary small">— данные и обложка подтянутся автоматически</span></label>
            <div class="d-flex gap-2">
                <div class="search-box flex-grow-1">
                    <span class="search-ico">⌕</span>
                    <input type="text" id="itunesQuery" class="form-control" placeholder="напр. Daft Punk Random Access Memories" />
                </div>
                <button type="button" class="btn btn-outline-light" id="itunesBtn">Искать</button>
            </div>
            <div id="itunesResults" class="itunes-results"></div>
        </div>

        <hr class="my-3" />

        <div class="row g-3">
            <div class="col-12 col-sm-5">
                <div class="cover-preview-wrap">
                    <img id="coverPreview" class="cover-preview" src="@Model.CoverUrl" alt=""
                         onerror="this.removeAttribute('src');" />
                </div>

                <label class="form-label mt-2">Обложка</label>
                <input name="coverUrl" id="coverUrl" class="form-control" value="@Model.CoverUrl"
                       placeholder="Ссылка https://…/cover.jpg" />

                <div class="cover-or">или</div>

                <input type="file" id="coverFile" accept="image/png,image/jpeg,image/webp,image/gif" class="d-none" />
                <button type="button" class="btn btn-outline-light w-100" id="coverUploadBtn">⤓ Загрузить файл</button>
                <div class="cover-status" id="coverStatus"></div>
            </div>

            <div class="col-12 col-sm-7">
                <div class="mb-3">
                    <label class="form-label">Название альбома *</label>
                    <input name="title" class="form-control" value="@Model.Title" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Исполнитель *</label>
                    <input name="artist" class="form-control" value="@Model.Artist" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Дата выхода</label>
                    <input name="releaseDate" type="date" class="form-control" value="@releaseValue" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Жанры <span class="text-secondary small">(через запятую)</span></label>
                    <input name="genres" class="form-control" value="@genresValue" placeholder="Rock, Pop, …" />
                </div>
            </div>
        </div>

        <hr class="my-3" />

        <div class="row g-3 align-items-center">
            <div class="col-12 col-sm-6">
                <label class="form-label d-block">Оценка</label>
                <input type="hidden" name="rating" id="ratingInput" value="@ratingValue" />
                <div class="d-flex align-items-center gap-2">
                    <div class="star-input" id="starInput" role="slider" aria-label="Оценка от 0 до 5"
                         aria-valuemin="0" aria-valuemax="5">
                        <span class="stars-base">★★★★★</span>
                        <span class="stars-fill" id="starFill">★★★★★</span>
                    </div>
                    <span class="rating-label" id="ratingLabel"></span>
                    <button type="button" class="btn btn-sm btn-link clear-rating" id="clearRating">сбросить</button>
                </div>
            </div>

            <div class="col-6 col-sm-3">
                <label class="form-label">Статус</label>
                <select name="status" class="form-select">
                    <option value="@AlbumStatus.Planned" selected="@(Model.Status == AlbumStatus.Planned)">В планах</option>
                    <option value="@AlbumStatus.Listened" selected="@(Model.Status == AlbumStatus.Listened)">Прослушано</option>
                </select>
            </div>

            <div class="col-6 col-sm-3">
                <label class="form-label d-block">Избранное</label>
                <div class="form-check form-switch fs-5">
                    <input class="form-check-input" type="checkbox" role="switch" name="isFavorite" value="true"
                           id="favSwitch" @(Model.IsFavorite ? "checked" : "") />
                    <label class="form-check-label small" for="favSwitch">♥ в избранном</label>
                </div>
            </div>
        </div>

        <div class="text-danger small mt-3 d-none" id="formError"></div>
    </div>

    <div class="modal-footer justify-content-between">
        <div>
            @if (isEdit)
            {
                <button type="button" class="btn btn-outline-danger" id="deleteBtn" data-id="@Model.Id">Удалить</button>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Отмена</button>
            <button type="submit" class="btn btn-accent">Сохранить</button>
        </div>
    </div>
</form>
